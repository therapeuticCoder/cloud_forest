{
  "name": "@cloud-forest/api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --experimental-strip-types --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env --experimental-strip-types src/main.ts",
    "openapi:generate": "node --experimental-strip-types scripts/openapi.mjs",
    "openapi:check": "node --experimental-strip-types scripts/openapi.mjs --check",
    "typecheck": "pnpm --dir ../web exec tsc --project ../api/tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:integration": "node --env-file-if-exists=../../.env --experimental-strip-types --test test/integration/*.test.mjs",
    "check": "pnpm typecheck && pnpm openapi:check && pnpm test"
  },
  "dependencies": {
    "@cloud-forest/api-contracts": "workspace:*",
    "@cloud-forest/database": "workspace:*",
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "fastify": "5.10.0",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/node": "24.12.4"
  }
}
