                                    {
                                      "enum": [
                                        "party"
                                      ],
                                      "type": "string"
                                    },
                                    {
                                      "enum": [
                                        "tribe"
                                      ],
                                      "type": "string"
                                    },
                                    {
                                      "enum": [
                                        "guild"
                                      ],
                                      "type": "string"
                                    },
                                    {
                                      "enum": [
                                        "signal"
                                      ],
                                      "type": "string"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "id",
                                "displayName",
                                "layer"
                              ],
                              "type": "object"
                            },
                            "content": {
                              "maxLength": 10000,
                              "minLength": 1,
                              "type": "string"
                            },
                            "id": {
                              "maxLength": 128,
                              "minLength": 1,
                              "type": "string"
                            },
                            "publishedAt": {
                              "format": "date-time",
                              "pattern": "Z$",
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "actor",
                            "content",
                            "publishedAt"
                          ],
                          "title": "TimelineItem",
                          "type": "object"
                        }
                      },
                      "required": [
