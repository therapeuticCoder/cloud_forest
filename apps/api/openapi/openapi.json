    "/api/v1/timeline-items/{timelineItemId}": {
      "get": {
        "operationId": "getTimelineItemV1",
        "parameters": [
          {
            "in": "path",
            "name": "timelineItemId",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
