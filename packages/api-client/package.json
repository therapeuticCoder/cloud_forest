{
  "name": "@cloud-forest/api-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generated:check": "node scripts/generate.mjs --check",
    "typecheck": "pnpm --dir ../../apps/web exec tsc --project ../../packages/api-client/tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "pnpm generated:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloud-forest/api-contracts": "workspace:*"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
