{
  "name": "human-forest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --filter @human-forest/web dev",
    "build": "pnpm --filter @human-forest/web build",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm --filter @human-forest/web test",
    "test:watch": "pnpm --filter @human-forest/web test:watch",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "services:up": "node scripts/docker.mjs compose up -d --wait",
    "services:down": "node scripts/docker.mjs compose down",
    "services:status": "node scripts/docker.mjs compose ps",
    "services:logs": "node scripts/docker.mjs compose logs --tail=100"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.2"
  }
}
