{
  "name": "cloud-forest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "clean:generated": "node scripts/clean-generated.mjs",
    "deps:repair": "node scripts/repair-dependencies.mjs",
    "dev": "pnpm --filter @cloud-forest/web dev",
    "dev:api": "pnpm --filter @cloud-forest/api dev",
    "start:api": "pnpm --filter @cloud-forest/api start",
    "openapi:generate": "pnpm --filter @cloud-forest/api openapi:generate && pnpm --filter @cloud-forest/api-client generate",
    "openapi:check": "pnpm --filter @cloud-forest/api openapi:check && pnpm --filter @cloud-forest/api-client generated:check",
    "build": "pnpm --filter @cloud-forest/web build",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm --filter @cloud-forest/domain typecheck && pnpm --filter @cloud-forest/api-contracts typecheck && pnpm --filter @cloud-forest/database typecheck && pnpm --filter @cloud-forest/api typecheck && pnpm --filter @cloud-forest/api-client typecheck",
    "test": "pnpm test:environment && pnpm --filter @cloud-forest/domain test && pnpm --filter @cloud-forest/api-contracts test && pnpm --filter @cloud-forest/database test && pnpm --filter @cloud-forest/api test && pnpm --filter @cloud-forest/api-client test && pnpm --filter @cloud-forest/web test",
    "test:environment": "node --test scripts/*.test.mjs",
    "check:api": "pnpm --filter @cloud-forest/api check",
    "test:watch": "pnpm --filter @cloud-forest/web test:watch",
    "check": "pnpm lint && pnpm format:check && pnpm openapi:check && pnpm typecheck && pnpm test && pnpm build",
    "services:up": "node scripts/docker.mjs compose up -d --wait",
    "services:down": "node scripts/docker.mjs compose down",
    "services:status": "node scripts/docker.mjs compose ps",
    "services:logs": "node scripts/docker.mjs compose logs --tail=100",
    "db:generate": "pnpm --filter @cloud-forest/database generate",
    "db:migrations:check": "pnpm --filter @cloud-forest/database migrations:check",
    "db:migrate": "pnpm --filter @cloud-forest/database migrate",
    "db:migrate:test": "pnpm --filter @cloud-forest/database migrate -- --test",
    "db:status": "pnpm --filter @cloud-forest/database status",
    "db:status:test": "pnpm --filter @cloud-forest/database status -- --test",
    "db:inspect": "pnpm --filter @cloud-forest/database inspect",
    "db:inspect:test": "pnpm --filter @cloud-forest/database inspect -- --test",
    "db:test:prepare": "pnpm --filter @cloud-forest/database test:prepare",
    "test:database": "pnpm db:test:prepare && pnpm db:migrate:test && pnpm --filter @cloud-forest/database test:integration && pnpm --filter @cloud-forest/api test:integration",
    "test:e2e": "node --env-file-if-exists=.env scripts/e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.2"
  }
}
